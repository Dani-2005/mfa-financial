<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Sin esto, el sandbox de macOS bloquea toda conexión de red saliente
	     de la app (aunque la Mac sí tenga internet), ya que todo pasa por
	     HTTPS al servidor. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Requerido para que "Guardar PDF" (recibos/reportes) pueda escribir
	     en la carpeta que el usuario elija en el diálogo de guardado. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Requerido para "Imprimir" (recibos/reportes): sin esto el sandbox
	     de macOS muestra "This application does not support printing". -->
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>
